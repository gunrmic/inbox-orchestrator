{
  "name": "inbox-orchestrator-menubar",
  "productName": "Inbox Orchestrator",
  "version": "0.2.0",
  "description": "Menu bar companion for inbox-orchestrator: approve, edit or reject prepared actions.",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node ../scripts/stage-cli.mjs && electron-builder --mac dmg --publish never",
    "test": "playwright test"
  },
  "dependencies": {
    "menubar": "^9.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.omermichaeli.inbox-orchestrator.menubar",
    "productName": "Inbox Orchestrator",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "assets/**",
      "setup.html",
      "setup.js",
      "setup.css"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "extraResources": [
      {
        "from": "../build/cli",
        "to": "cli",
        "filter": [
          "**/*"
        ]
      }
    ],
    "dmg": {
      "title": "Inbox Orchestrator",
      "artifactName": "Inbox-Orchestrator.${ext}"
    },
    "directories": {
      "output": "../build/dist"
    }
  },
  "author": "Omer Michaeli"
}
